# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas connection string.
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/hcm_lite?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hcm_lite?retryWrites=true&w=majority"

# JWT_SECRET: Strong secret key for signing JWT tokens.
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters"

# PORT: Server port (defaults to 3000)
PORT=3000

# INITIAL_ADMIN_EMAIL: Initial authorized super admin bootstrap email
INITIAL_ADMIN_EMAIL="asadqadri239@gmail.com"
